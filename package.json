{
  "name": "asanchez",
  "version": "1.0.0",
  "description": "Asanchez — агент для контроля стандартов задач Asana (Prestige Expo)",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "poll": "tsx src/scripts/pollProjects.ts",
    "weekly-scan": "tsx src/scripts/runWeeklyScan.ts",
    "pulse": "tsx src/scripts/buildPulse.ts",
    "register-webhooks": "tsx src/scripts/registerWebhooks.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}

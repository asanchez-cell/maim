# --- Asana ---
# Personal Access Token: https://app.asana.com/0/my-apps
ASANA_ACCESS_TOKEN=

# Секрет для подписи вебхуков Asana (генерируется автоматически при регистрации,
# но можно задать заранее — тот же секрет нужно передать в registerWebhooks)
ASANA_WEBHOOK_SECRET=

# --- Anthropic (Claude) ---
# Ключ для смысловых проверок: перевод ES<->RU, проверка инфинитива, оценка дублей
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Сервис ---
# Порт, на котором слушает HTTP-сервер (вебхуки Asana)
PORT=3000

# Публичный HTTPS-адрес этого сервиса (нужен для регистрации вебхуков Asana)
PUBLIC_BASE_URL=https://your-domain.example.com

# GID проекта Prestige Expo (PEX), куда публикуется сводный отчёт о дублях
REPORT_PROJECT_GID=

# Расписание еженедельной проверки дублей (cron, по умолчанию — воскресенье 09:00)
DUPLICATE_SCAN_CRON=0 9 * * 0
DUPLICATE_SCAN_TZ=Europe/Madrid
